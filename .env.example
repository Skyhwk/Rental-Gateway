APP_NAME="Rental Gateway Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:5152
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rental_gateway
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Gateway Agent (internal — localhost)
GATEWAY_AGENT_ENABLED=false
GATEWAY_AGENT_BASE_URL=http://127.0.0.1:8750
GATEWAY_AGENT_TOKEN=
GATEWAY_AGENT_TIMEOUT_SECONDS=30
GATEWAY_AGENT_SYSTEMD_UNIT=rental-gateway-agent
GATEWAY_AGENT_SERVICE_CONTROL=true
GATEWAY_AGENT_CTL=/usr/local/sbin/rental-gateway-agent-ctl
GATEWAY_CONFIG_ROOT=/var/www/html/Laravel-Rental-Manager/storage/gateway/runtime
GATEWAY_STATIC_ROOT=/var/www/html/Laravel-Rental-Manager/gateway/static
GATEWAY_LISTENER_PORT=8080
GATEWAY_ALLOWED_HOST=127.0.0.1
GATEWAY_PORT_MIN=1
GATEWAY_PORT_MAX=65535

BILLING_AUTO_ACTIVATE_ON_PAYMENT=true
BILLING_AUTO_SUSPEND=true
BILLING_INVOICE_GENERATE_DAYS_BEFORE=7
BILLING_SUSPEND_AT_TIME=09:00
BILLING_SUSPEND_RUN_AT=09:05
BILLING_INVOICE_PREFIX=INV
BILLING_ISSUER_NAME="${APP_NAME}"
BILLING_ISSUER_SUBTITLE="Pengelola sewa aplikasi web — perorangan / UMKM"
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_EMAIL=
BILLING_ISSUER_PHONE=
BILLING_PAYMENT_RECIPIENT=
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_PAYMENT_PROOF_DISK=local
MONITORING_HEALTH_TIMEOUT=5
# Path probe HTTP ke backend client (host:port aplikasi). Default /. Jangan /v1/health (itu Gateway Agent :8750).
MONITORING_HEALTH_PATH=/
MONITORING_HOST_METRICS=true

PAYMENT_PROOF_MAX_KB=5120
LOGIN_RATE_LIMIT=5

# Super Admin (AdminUserSeeder — dibaca via config/admin.php)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@rental-gateway.local
SUPER_ADMIN_PASSWORD=

