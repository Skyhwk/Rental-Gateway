# Generated by Rental Gateway Agent — application {{ application_id }}
# Mode: {{ access_mode }}

<VirtualHost *:{{ listener_port }}>
    ServerName {{ primary_hostname }}
{% for alias in alias_hostnames %}
    ServerAlias {{ alias }}
{% endfor %}

{% if access_mode == 'active' %}
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    Header always set X-Rental-Gateway-Status "active"

    ProxyPass / http://{{ internal_host }}:{{ internal_port }}/ connectiontimeout=5 timeout=300
    ProxyPassReverse / http://{{ internal_host }}:{{ internal_port }}/

{% if websocket_enabled %}
    ProxyPass {{ websocket_path }} ws://{{ internal_host }}:{{ internal_port }}{{ websocket_path }}
    ProxyPassReverse {{ websocket_path }} ws://{{ internal_host }}:{{ internal_port }}{{ websocket_path }}
{% endif %}

{% elif access_mode == 'maintenance' %}
    DocumentRoot "{{ static_maintenance_dir }}"
    DirectoryIndex index.html
    <Directory "{{ static_maintenance_dir }}">
        Require all granted
        Options -Indexes
        AllowOverride None
    </Directory>
    ErrorDocument 503 /index.html
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
    RewriteRule ^.*$ /index.html [R=503,L]
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set X-Rental-Gateway-Status "maintenance"

{% else %}
    DocumentRoot "{{ static_suspend_dir }}"
    DirectoryIndex index.html
    <Directory "{{ static_suspend_dir }}">
        Require all granted
        Options -Indexes
        AllowOverride None
    </Directory>
    ErrorDocument 503 /index.html
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
    RewriteRule ^.*$ /index.html [R=503,L]
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set X-Rental-Gateway-Status "suspended"
{% endif %}
</VirtualHost>
